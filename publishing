  <b:skin><![CDATA[

  /* =========================================================
     E.C. VICTORIA — PREMIUM BLOGGER AUTHOR THEME
     ========================================================= */

  :root{
    --forest:#173A35;
    --forest-dark:#0F2925;
    --blue:#1F355B;
    --ivory:#F8F5EF;
    --paper:#FFFDF9;
    --gold:#C7A15A;
    --gold-dark:#9D7735;
    --sage:#95A98C;
    --text:#25251F;
    --muted:#68665E;
    --line:#E4DED2;
    --white:#FFFFFF;
    --shadow:0 18px 50px rgba(23,58,53,.10);
    --max:1180px;
  }

  *{
    box-sizing:border-box;
    margin:0;
    padding:0;
  }

  html{
    scroll-behavior:smooth;
  }

  body{
    font-family:Georgia,'Times New Roman',serif;
    background:var(--ivory);
    color:var(--text);
    line-height:1.75;
  }

  a{
    color:inherit;
    text-decoration:none;
  }

  img{
    max-width:100%;
    height:auto;
  }

  .container{
    width:min(92%,var(--max));
    margin:auto;
  }

  /* =========================
     HEADER
     ========================= */

  .site-header{
    position:sticky;
    top:0;
    z-index:9999;
    background:rgba(255,253,249,.97);
    border-bottom:1px solid var(--line);
    backdrop-filter:blur(12px);
  }

  .header-inner{
    min-height:82px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:30px;
  }

  .brand{
    display:flex;
    flex-direction:column;
    line-height:1;
  }

  .brand-main{
    font-size:1.35rem;
    letter-spacing:.18em;
    font-weight:bold;
    color:var(--forest);
  }

  .brand-sub{
    margin-top:8px;
    font-family:Arial,sans-serif;
    font-size:.58rem;
    letter-spacing:.28em;
    text-transform:uppercase;
    color:var(--gold-dark);
  }

  .nav{
    display:flex;
    align-items:center;
    gap:30px;
    font-family:Arial,sans-serif;
    font-size:.72rem;
    letter-spacing:.13em;
    text-transform:uppercase;
  }

  .nav a{
    position:relative;
    padding:10px 0;
    color:var(--forest);
  }

  .nav a:after{
    content:'';
    position:absolute;
    left:0;
    bottom:3px;
    width:0;
    height:1px;
    background:var(--gold);
    transition:.3s;
  }

  .nav a:hover:after{
    width:100%;
  }

  .menu-btn{
    display:none;
    border:1px solid var(--line);
    background:transparent;
    padding:9px 12px;
    font-size:1.1rem;
    cursor:pointer;
    color:var(--forest);
  }

  /* =========================
     HERO
     ========================= */

  .hero{
    position:relative;
    min-height:720px;
    display:flex;
    align-items:center;
    overflow:hidden;
    background:
      radial-gradient(circle at 12% 20%,rgba(199,161,90,.15),transparent 28%),
      radial-gradient(circle at 88% 75%,rgba(31,53,91,.12),transparent 32%),
      var(--ivory);
  }

  .hero:before{
    content:'';
    position:absolute;
    width:420px;
    height:420px;
    border:1px solid rgba(199,161,90,.22);
    border-radius:50%;
    right:-150px;
    top:-100px;
  }

  .hero:after{
    content:'';
    position:absolute;
    width:260px;
    height:260px;
    border:1px solid rgba(23,58,53,.12);
    border-radius:50%;
    left:-100px;
    bottom:-80px;
  }

  .hero-content{
    position:relative;
    z-index:2;
    max-width:820px;
    padding:110px 0;
  }

  .eyebrow{
    font-family:Arial,sans-serif;
    font-size:.67rem;
    letter-spacing:.28em;
    text-transform:uppercase;
    color:var(--gold-dark);
    margin-bottom:22px;
  }

  .hero h1{
    color:var(--forest);
    font-size:clamp(3.3rem,7vw,6.6rem);
    line-height:.98;
    font-weight:500;
    margin-bottom:28px;
  }

  .hero h1 em{
    color:var(--gold-dark);
    font-weight:400;
  }

  .hero-description{
    max-width:650px;
    color:var(--muted);
    font-size:1.12rem;
    margin-bottom:36px;
  }

  .buttons{
    display:flex;
    flex-wrap:wrap;
    gap:14px;
  }

  .btn{
    display:inline-block;
    padding:14px 25px;
    border:1px solid var(--forest);
    font-family:Arial,sans-serif;
    font-size:.68rem;
    letter-spacing:.15em;
    text-transform:uppercase;
    transition:.3s;
  }

  .btn-primary{
    background:var(--forest);
    color:white;
  }

  .btn:hover{
    transform:translateY(-3px);
    background:var(--gold-dark);
    border-color:var(--gold-dark);
    color:white;
  }

  /* =========================
     GENERAL SECTIONS
     ========================= */

  section{
    padding:105px 0;
  }

  .section-head{
    max-width:720px;
    margin:0 auto 60px;
    text-align:center;
  }

  .section-head h2{
    color:var(--forest);
    font-size:clamp(2.4rem,5vw,4rem);
    line-height:1.05;
    font-weight:500;
    margin-bottom:18px;
  }

  .section-head p{
    color:var(--muted);
  }

  /* =========================
     BOOKS
     ========================= */

  #books{
    background:var(--paper);
  }

  .books-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:30px;
  }

  .book-card{
    background:white;
    border:1px solid var(--line);
    padding:18px;
    transition:.35s;
  }

  .book-card:hover{
    transform:translateY(-8px);
    box-shadow:var(--shadow);
  }

  .book-cover{
    height:390px;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:40px;
    position:relative;
    overflow:hidden;
    margin-bottom:24px;
  }

  .book-cover:before{
    content:'';
    position:absolute;
    inset:14px;
    border:1px solid rgba(255,255,255,.55);
  }

  .cover-one{
    background:
      radial-gradient(circle at 20% 20%,rgba(255,255,255,.2),transparent 30%),
      linear-gradient(145deg,#173A35,#315D52);
  }

  .cover-two{
    background:
      radial-gradient(circle at 80% 20%,rgba(255,255,255,.2),transparent 28%),
      linear-gradient(145deg,#1F355B,#48658D);
  }

  .cover-three{
    background:
      radial-gradient(circle at 30% 70%,rgba(255,255,255,.22),transparent 28%),
      linear-gradient(145deg,#C7A15A,#806335);
  }

  .cover-content{
    position:relative;
    z-index:2;
    color:white;
  }

  .cover-label{
    font-family:Arial,sans-serif;
    font-size:.6rem;
    letter-spacing:.2em;
    text-transform:uppercase;
  }

  .cover-title{
    font-size:2.05rem;
    line-height:1.05;
    font-weight:500;
    margin:20px 0;
  }

  .book-card h3{
    color:var(--forest);
    font-size:1.45rem;
    font-weight:500;
  }

  .book-card p{
    color:var(--muted);
    font-size:.92rem;
    margin:10px 0 20px;
  }

  .book-link{
    font-family:Arial,sans-serif;
    font-size:.65rem;
    letter-spacing:.13em;
    text-transform:uppercase;
    color:var(--gold-dark);
  }

  /* =========================
     AUTHOR
     ========================= */

  #about{
    background:var(--ivory);
  }

  .about-grid{
    display:grid;
    grid-template-columns:.8fr 1.2fr;
    gap:85px;
    align-items:center;
  }

  .author-frame{
    min-height:510px;
    background:
      linear-gradient(rgba(23,58,53,.08),rgba(23,58,53,.08)),
      var(--sage);
    border:10px solid white;
    outline:1px solid var(--line);
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:40px;
    box-shadow:var(--shadow);
  }

  .author-frame span{
    font-family:Arial,sans-serif;
    font-size:.68rem;
    letter-spacing:.16em;
    text-transform:uppercase;
    color:var(--forest);
  }

  .about-copy h2{
    color:var(--forest);
    font-size:clamp(2.5rem,5vw,4.3rem);
    line-height:1.05;
    font-weight:500;
    margin-bottom:28px;
  }

  .about-copy p{
    color:var(--muted);
    margin-bottom:18px;
  }

  .signature{
    color:var(--gold-dark);
    font-size:1.55rem;
    font-style:italic;
    margin-top:28px;
  }

  /* =========================
     BLOG
     ========================= */

  #blog{
    background:var(--paper);
  }

  .blog-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:30px;
  }

  .blog-card{
    padding:30px 0;
    border-top:1px solid var(--line);
    transition:.3s;
  }

  .blog-card:hover{
    transform:translateY(-5px);
  }

  .blog-category{
    font-family:Arial,sans-serif;
    color:var(--gold-dark);
    font-size:.63rem;
    letter-spacing:.14em;
    text-transform:uppercase;
  }

  .blog-card h3{
    color:var(--forest);
    font-size:1.5rem;
    line-height:1.25;
    font-weight:500;
    margin:15px 0;
  }

  .blog-card p{
    color:var(--muted);
    font-size:.92rem;
    margin-bottom:18px;
  }

  /* =========================
     NEWSLETTER
     ========================= */

  .newsletter{
    background:var(--forest);
    color:white;
    text-align:center;
    padding:90px 25px;
  }

  .newsletter h2{
    font-size:clamp(2.3rem,5vw,4rem);
    line-height:1.05;
    font-weight:500;
  }

  .newsletter p{
    max-width:620px;
    margin:18px auto 30px;
    color:#D9E1DC;
  }

  .newsletter .btn{
    border-color:var(--gold);
    color:white;
  }

  /* =========================
     CONTACT
     ========================= */

  #contact{
    background:var(--ivory);
  }

  .contact{
    max-width:780px;
    text-align:center;
    margin:auto;
  }

  .contact h2{
    color:var(--forest);
    font-size:clamp(2.5rem,5vw,4.2rem);
    font-weight:500;
  }

  .contact p{
    color:var(--muted);
    margin:18px auto 30px;
    max-width:650px;
  }

  /* =========================
     FOOTER
     ========================= */

  footer{
    background:var(--paper);
    border-top:1px solid var(--line);
    padding:38px 0;
  }

  .footer-inner{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:25px;
  }

  .copyright{
    font-family:Arial,sans-serif;
    color:var(--muted);
    font-size:.68rem;
  }

  .socials{
    display:flex;
    gap:22px;
    font-family:Arial,sans-serif;
    font-size:.65rem;
    letter-spacing:.08em;
    text-transform:uppercase;
  }

  .socials a:hover{
    color:var(--gold-dark);
  }

  /* =========================
     BLOGGER CLEANUP
     ========================= */

  .blogger-section{
    display:none;
  }

  /* =========================
     MOBILE
     ========================= */

  @media(max-width:850px){

    .nav{
      display:none;
      position:absolute;
      top:82px;
      left:0;
      right:0;
      background:var(--paper);
      border-bottom:1px solid var(--line);
      padding:25px;
      flex-direction:column;
      gap:10px;
    }

    .nav.open{
      display:flex;
    }

    .menu-btn{
      display:block;
    }

    .hero{
      min-height:650px;
    }

    .hero-content{
      padding:90px 0;
    }

    .books-grid,
    .blog-grid{
      grid-template-columns:1fr;
    }

    .about-grid{
      grid-template-columns:1fr;
      gap:50px;
    }

    .author-frame{
      min-height:400px;
    }

    section{
      padding:75px 0;
    }

    .footer-inner{
      flex-direction:column;
      text-align:center;
    }

  }

  @media(max-width:500px){

    .brand-main{
      font-size:1.05rem;
    }

    .hero h1{
      font-size:3.1rem;
    }

    .buttons{
      flex-direction:column;
      align-items:stretch;
    }

    .btn{
      text-align:center;
    }

    .book-cover{
      height:350px;
    }

  }

  ]]></b:skin>

</head>


