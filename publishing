<head>

  <meta charset='UTF-8'/>
  <meta name='viewport' content='width=device-width, initial-scale=1.0'/>

  <meta name='description'
        content='E.C. Victoria — Author and storyteller creating imaginative children’s books, journals and inspiring stories for curious minds and thoughtful readers.'/>

